{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stavebak",
  "version": "0.13.0",
  "identifier": "cz.stavebak.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stavebak",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:*; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/en.lproj": "en.lproj"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzMjhEMDgzMzQxQjBEOUEKUldTYURSczBnOUFvSTZETHJGb3hDcGpMZEZRSDVmQnRrcDFOeWp5SXBGT1J4ZitvaVJXS1hqMWsK",
      "endpoints": [
        "https://github.com/Juicyscoop88/stavebak-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
